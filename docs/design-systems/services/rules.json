{
 "theme": "services",
 "repoThemeId": "services",
 "note": "Same shape as docs/design-systems/free-human/rules.json. First match wins. The zip is a theme-editor framework handoff plus the Services kit; the framework half is built in lib/theme/dials.* (plan steps 1-4).",
 "tokenSources": [
  "SERVICES_TOKENS_CSS"
 ],
 "baseline": "docs/design-systems/services/baseline.json",
 "tokenMap": [
  {
   "from": "--ink-",
   "to": "--sv-ink-"
  },
  {
   "from": "--graphite-",
   "to": "--sv-graphite-"
  },
  {
   "from": "--chrome-",
   "to": "--sv-chrome-"
  },
  {
   "from": "--salt-",
   "to": "--sv-salt-"
  },
  {
   "from": "--flare-",
   "to": "--sv-flare-"
  },
  {
   "from": "--swell-",
   "to": "--sv-swell-"
  },
  {
   "from": "--halo-",
   "to": "--sv-halo-"
  },
  {
   "from": "--success-",
   "to": "--sv-success-"
  },
  {
   "from": "--warning-",
   "to": "--sv-warning-"
  },
  {
   "from": "--danger-",
   "to": "--sv-danger-"
  },
  {
   "from": "--",
   "to": "--sv-"
  }
 ],
 "rules": [
  {
   "glob": "design_handoff_theme_editor/reference/tokens/frequency.css",
   "kind": "built",
   "target": "lib/sites/editor/theme-contract.json",
   "reason": "The --th-* bridge is published as themes.Services; the site-look attribute rules (data-site-*, data-th, data-type, data-motion) land in components/sites/services-css.ts with the chrome (LIVE-1992)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/tokens/base.css",
   "kind": "built",
   "target": "components/sites/services-css.ts",
   "reason": "Type voices, image treatments and base element rules (LIVE-1992)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/tokens/effects.css",
   "kind": "built",
   "target": "components/sites/services-css.ts",
   "reason": "Orbs, glints, sweep and reveals behind prefers-reduced-motion (LIVE-1992)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/tokens/textures.css",
   "kind": "built",
   "target": "components/sites/services-css.ts",
   "reason": "Grain and dot-grid textures (LIVE-1992)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/tokens/*.css",
   "kind": "tokens",
   "reason": "Compared value for value with SERVICES_TOKENS_CSS under tokenMap (every name gains --sv-)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/assets/frequency-logo.png",
   "kind": "reference",
   "reason": "Frequency's own mark, drawn in the Space and Templates chrome; the repo already carries it."
  },
  {
   "glob": "design_handoff_theme_editor/reference/_ds_bundle.js",
   "kind": "reference",
   "reason": "Generated bundle; never shipped."
  },
  {
   "glob": "design_handoff_theme_editor/reference/styles.css",
   "kind": "reference",
   "reason": "Entry file that @imports tokens/*.css."
  },
  {
   "glob": "design_handoff_theme_editor/reference/readme.md",
   "kind": "reference",
   "reason": "Voice, colour, type and shape rules; values checked through tokens/*.css."
  },
  {
   "glob": "design_handoff_theme_editor/reference/HANDOFF.md",
   "kind": "reference",
   "reason": "Handoff text; every file it names is checked by the rule for that file."
  },
  {
   "glob": "design_handoff_theme_editor/reference/components/**",
   "kind": "reference",
   "reason": "Prototype primitives; the live site draws the same look through registry blocks styled by components/sites/services-*-css.ts."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/site/kits.js",
   "kind": "built",
   "target": "lib/sites/kits/services-variants.ts",
   "reason": "The sixteen kits as SiteKit pages (plan step 6)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/site/record.js",
   "kind": "built",
   "target": "lib/spotlight/services-kit-content.ts",
   "reason": "Builds DOORS from each kit's tools (plan step 7)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/site/controls.jsx",
   "kind": "built",
   "target": "components/sites/editor/theme-controls.tsx",
   "reason": "ThemeControls (plan step 4)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/site/Blocks.jsx",
   "kind": "built",
   "target": "components/page-editor/blocks/services.tsx",
   "reason": "The Services blocks (plan step 5)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/site/Chrome.jsx",
   "kind": "built",
   "target": "components/sites/services-chrome.tsx",
   "reason": "Header (bar|pill|centered) and footer (full|minimal)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/site/*.jsx",
   "kind": "reference",
   "reason": "Page compositions of the Services blocks; the live pages are kit pages of registry blocks."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/products/Spotlight.jsx",
   "kind": "built",
   "target": "components/spotlight/services-kit-layouts.tsx",
   "reason": "Six Spotlight layouts (plan step 7)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/products/*.jsx",
   "kind": "reference",
   "reason": "Phone frame and shared prototype helpers."
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/products/SpacePage.html",
   "kind": "copy",
   "targets": [
    "lib/sites",
    "components/sites",
    "components/page-editor/blocks",
    "components/spotlight",
    "lib/spotlight",
    "lib/theme"
   ]
  },
  {
   "glob": "design_handoff_theme_editor/reference/ui_kits/products/EmailPage.html",
   "kind": "copy",
   "targets": [
    "lib/theme",
    "lib/sites",
    "components/sites"
   ]
  },
  {
   "glob": "design_handoff_theme_editor/reference/Spotlight Layouts.html",
   "kind": "copy",
   "targets": [
    "components/spotlight",
    "lib/spotlight",
    "lib/sites",
    "lib/theme"
   ]
  },
  {
   "glob": "design_handoff_theme_editor/reference/Web Theme.html",
   "kind": "copy",
   "targets": [
    "lib/sites",
    "components/sites",
    "components/page-editor/blocks",
    "lib/themes"
   ]
  },
  {
   "glob": "design_handoff_theme_editor/reference/Theme Feature Page.html",
   "kind": "copy",
   "targets": [
    "lib/themes",
    "app/themes",
    "components/themes"
   ]
  },
  {
   "glob": "design_handoff_theme_editor/reference/Kit Overview.html",
   "kind": "reference",
   "reason": "Acceptance page, rebuilt from the manifest functions table at /themes/services/overview (plan step 7); its copy is the manifest's."
  },
  {
   "glob": "design_handoff_theme_editor/reference/Conformance.html",
   "kind": "reference",
   "reason": "The ten invariants; implemented as lib/theme/conformance.ts and tests (plan step 8)."
  },
  {
   "glob": "design_handoff_theme_editor/reference/Templates.html",
   "kind": "reference",
   "reason": "Template gallery for Claude Design; not a Frequency surface."
  },
  {
   "glob": "design_handoff_theme_editor/frequency/theme-contract.services.json",
   "kind": "built",
   "target": "lib/sites/editor/theme-contract.json",
   "reason": "Merged as themes.Services; theme.test.ts checks every string value."
  },
  {
   "glob": "design_handoff_theme_editor/frequency/kits.services.json",
   "kind": "built",
   "target": "lib/sites/kits/services-variants.ts"
  },
  {
   "glob": "design_handoff_theme_editor/frequency/README.md",
   "kind": "reference",
   "reason": "Install steps."
  },
  {
   "glob": "design_handoff_theme_editor/dials.json",
   "kind": "built",
   "target": "lib/theme/dials.json",
   "reason": "Dial registry (plan step 1)."
  },
  {
   "glob": "design_handoff_theme_editor/manifest.schema.md",
   "kind": "reference",
   "reason": "Schema 2 spec; implemented in lib/themes/manifests.test.ts (plan step 2)."
  },
  {
   "glob": "design_handoff_theme_editor/THEME-EDITOR-FRAMEWORK.md",
   "kind": "reference",
   "reason": "The framework spec."
  },
  {
   "glob": "design_handoff_theme_editor/IMPLEMENTATION-PLAN.md",
   "kind": "reference",
   "reason": "Build order; status lives in the ledger rows, never here."
  },
  {
   "glob": "design_handoff_theme_editor/README.md",
   "kind": "reference",
   "reason": "Handoff front page."
  }
 ]
}
