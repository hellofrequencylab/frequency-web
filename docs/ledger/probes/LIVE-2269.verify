node -e 'const fs=require("node:fs");const layout=fs.readFileSync("app/(main)/layout.tsx","utf8");const policy=fs.readFileSync("lib/offers/offer-bar-policy.ts","utf8");const zone=fs.readFileSync("lib/time/home-zone.ts","utf8");const tests=fs.readFileSync("lib/offers/offer-bar-policy.test.ts","utf8");if(!layout.includes("offerBarDisplayState(offerState)")||!layout.includes("<OfferBar")||!policy.includes("timeZone: HOME_TZ")||!zone.includes("America/Los_Angeles")||!tests.includes("2027-02-01T08:00:00.000Z"))process.exit(1)'
