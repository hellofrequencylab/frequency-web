{
  "name": "frequency-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "postbuild": "node scripts/check-build-budget.mjs && node scripts/check-og-trace.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:update": "playwright test --update-snapshots --grep @visual",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "e2e:session": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types test/e2e/mint-storage-state.mts",
    "a11y:baselines": "node scripts/a11y-baselines.mjs",
    "test:rls": "supabase test db",
    "check:authz": "node scripts/check-authz-guards.mjs",
    "check:canon": "node scripts/check-canon.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:menu": "node scripts/check-menu.mjs",
    "check:gate-parity": "node scripts/check-gate-parity.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:elements": "node scripts/check-elements.mjs",
    "check:labels": "node scripts/check-labels.mjs",
    "check:render-path": "node scripts/check-render-path.mjs",
    "check:help": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/help-coverage.mts --strict",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "check:phantom": "node scripts/check-phantom-classes.mjs",
    "check:bridge": "node scripts/check-bridge.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:adoption": "node scripts/check-adoption.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:grants": "node scripts/check-grants.mjs",
    "check:admin-client": "node scripts/check-admin-client.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:og-trace": "node scripts/check-og-trace.mjs",
    "check:build-budget": "node scripts/check-build-budget.mjs",
    "check:studio": "node scripts/check-studio.mjs",
    "check:creates": "node scripts/check-creates.mjs",
    "check:collective": "node scripts/check-collective.mjs",
    "check:crm-parity": "node scripts/check-crm-parity.mjs",
    "check:vocab": "node scripts/check-vocab.mjs",
    "backlog": "node scripts/check-backlog.mjs --report",
    "check:backlog": "node scripts/check-backlog.mjs",
    "check:one-list": "node scripts/check-one-list.mjs",
    "check:adr": "node scripts/check-adr.mjs",
    "check:docs-links": "node scripts/check-docs-links.mjs",
    "check:cron-freshness": "node scripts/cron-freshness.mjs",
    "maintenance:ledger-parity": "node scripts/maintenance/ledger-parity.mjs",
    "help:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/help-coverage.mts",
    "help:index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/help-index.mts",
    "help:drift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/help-drift.mts",
    "seed:demo-space": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/seed-demo-space.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@iconify/utils": "^3.1.4",
