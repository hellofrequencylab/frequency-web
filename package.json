    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@types/papaparse": "^5.5.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "heic2any": "^0.0.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "maplibre-gl": "^6.3.0",
    "next": "16.3.1",
    "papaparse": "^5.6.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "resend": "^6.20.0",
    "sharp": ">=0.35.0",
    "stripe": "^22.5.0",
    "tz-lookup": "^6.1.25",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/types": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": ">=0.35.0",
      "brace-expansion@>=5.0.0 <5.0.8": ">=5.0.8"
    }
  }
}
