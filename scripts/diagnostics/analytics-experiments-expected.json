    {
      "rls": true,
      "name": "analytics_experiments",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "default": "gen_random_uuid()",
          "notNull": true
        },
        {
          "name": "key",
          "type": "text",
          "default": null,
          "notNull": true
        },
        {
          "name": "status",
          "type": "text",
          "default": "'draft'::text",
          "notNull": true
        },
        {
          "name": "primary_event",
          "type": "text",
          "default": null,
          "notNull": true
        },
        {
          "name": "treatment_percent",
          "type": "integer",
          "default": "50",
          "notNull": true
        },
        {
          "name": "target_per_arm",
          "type": "integer",
          "default": "100",
          "notNull": true
        },
        {
          "name": "minimum_days",
          "type": "integer",
          "default": "7",
          "notNull": true
        },
        {
          "name": "conversion_days",
          "type": "integer",
          "default": "7",
          "notNull": true
        },
        {
          "name": "created_by",
          "type": "uuid",
          "default": null,
          "notNull": false
        },
        {
          "name": "updated_by",
          "type": "uuid",
          "default": null,
          "notNull": false
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "default": "now()",
          "notNull": true
        },
        {
          "name": "started_at",
          "type": "timestamp with time zone",
          "default": null,
          "notNull": false
        },
        {
          "name": "finished_at",
          "type": "timestamp with time zone",
          "default": null,
          "notNull": false
        },
        {
          "name": "guardrails_reviewed_at",
          "type": "timestamp with time zone",
          "default": null,
          "notNull": false
        },
        {
          "name": "control_excluded",
          "type": "bigint",
          "default": "0",
          "notNull": true
        },
        {
          "name": "treatment_excluded",
          "type": "bigint",
          "default": "0",
          "notNull": true
        }
      ],
      "indexes": [
        "CREATE INDEX analytics_experiments_created_by_idx ON public.analytics_experiments USING btree (created_by)",
        "CREATE UNIQUE INDEX analytics_experiments_key_key ON public.analytics_experiments USING btree (key)",
        "CREATE UNIQUE INDEX analytics_experiments_pkey ON public.analytics_experiments USING btree (id)",
        "CREATE INDEX analytics_experiments_updated_by_idx ON public.analytics_experiments USING btree (updated_by)"
      ],
      "forceRls": false,
      "policies": [],
      "anonAnyData": false,
      "constraints": [
        {
          "name": "analytics_experiments_control_excluded_not_null",
          "definition": "NOT NULL control_excluded"
        },
        {
          "name": "analytics_experiments_conversion_days_check",
          "definition": "CHECK (conversion_days >= 1 AND conversion_days <= 28)"
        },
        {
          "name": "analytics_experiments_conversion_days_not_null",
          "definition": "NOT NULL conversion_days"
        },
        {
          "name": "analytics_experiments_created_at_not_null",
          "definition": "NOT NULL created_at"
        },
        {
          "name": "analytics_experiments_created_by_fkey",
          "definition": "FOREIGN KEY (created_by) REFERENCES profiles(id) ON DELETE SET NULL"
        },
        {
          "name": "analytics_experiments_id_not_null",
          "definition": "NOT NULL id"
        },
        {
          "name": "analytics_experiments_key_check",
          "definition": "CHECK (key = 'upcoming-next-step'::text)"
        },
        {
          "name": "analytics_experiments_key_key",
          "definition": "UNIQUE (key)"
        },
        {
          "name": "analytics_experiments_key_not_null",
          "definition": "NOT NULL key"
        },
        {
          "name": "analytics_experiments_minimum_days_check",
          "definition": "CHECK (minimum_days >= 7 AND minimum_days <= 90)"
        },
        {
          "name": "analytics_experiments_minimum_days_not_null",
          "definition": "NOT NULL minimum_days"
        },
        {
          "name": "analytics_experiments_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "analytics_experiments_primary_event_check",
          "definition": "CHECK (primary_event = 'event.rsvp'::text)"
        },
        {
          "name": "analytics_experiments_primary_event_not_null",
          "definition": "NOT NULL primary_event"
        },
        {
          "name": "analytics_experiments_status_check",
          "definition": "CHECK (status = ANY (ARRAY['draft'::text, 'running'::text, 'paused'::text, 'completed'::text]))"
        },
        {
          "name": "analytics_experiments_status_not_null",
          "definition": "NOT NULL status"
        },
        {
          "name": "analytics_experiments_target_per_arm_check",
          "definition": "CHECK (target_per_arm >= 30)"
        },
        {
          "name": "analytics_experiments_target_per_arm_not_null",
          "definition": "NOT NULL target_per_arm"
        },
        {
          "name": "analytics_experiments_treatment_excluded_not_null",
          "definition": "NOT NULL treatment_excluded"
        },
        {
          "name": "analytics_experiments_treatment_percent_check",
          "definition": "CHECK (treatment_percent >= 1 AND treatment_percent <= 50)"
        },
        {
          "name": "analytics_experiments_treatment_percent_not_null",
          "definition": "NOT NULL treatment_percent"
        },
        {
          "name": "analytics_experiments_updated_by_fkey",
          "definition": "FOREIGN KEY (updated_by) REFERENCES profiles(id) ON DELETE SET NULL"
        }
      ],
