          "notNull": false
        }
      ],
      "indexes": [
        "CREATE INDEX analytics_experiment_assignments_age_idx ON public.analytics_experiment_assignments USING btree (assigned_at)",
        "CREATE UNIQUE INDEX analytics_experiment_assignments_pkey ON public.analytics_experiment_assignments USING btree (experiment_id, profile_id)",
        "CREATE INDEX analytics_experiment_assignments_profile_idx ON public.analytics_experiment_assignments USING btree (profile_id)"
      ],
      "forceRls": false,
      "policies": [],
      "anonAnyData": false,
      "constraints": [
        {
          "name": "analytics_experiment_assignments_assigned_at_not_null",
          "definition": "NOT NULL assigned_at"
        },
        {
          "name": "analytics_experiment_assignments_experiment_id_fkey",
          "definition": "FOREIGN KEY (experiment_id) REFERENCES analytics_experiments(id) ON DELETE CASCADE"
        },
        {
          "name": "analytics_experiment_assignments_experiment_id_not_null",
          "definition": "NOT NULL experiment_id"
        },
        {
          "name": "analytics_experiment_assignments_pkey",
          "definition": "PRIMARY KEY (experiment_id, profile_id)"
        },
        {
          "name": "analytics_experiment_assignments_profile_id_fkey",
          "definition": "FOREIGN KEY (profile_id) REFERENCES profiles(id) ON DELETE CASCADE"
        },
        {
          "name": "analytics_experiment_assignments_profile_id_not_null",
          "definition": "NOT NULL profile_id"
        },
        {
          "name": "analytics_experiment_assignments_variant_check",
          "definition": "CHECK (variant = ANY (ARRAY['control'::text, 'treatment'::text]))"
        },
        {
          "name": "analytics_experiment_assignments_variant_not_null",
          "definition": "NOT NULL variant"
        }
      ],
