# Frequency Experience runtime settings. Copy to mobile/.env (gitignored) and rebuild: EXPO_PUBLIC_*
# values are inlined into the JavaScript bundle. All three are public (the anon key is the one the
# website ships to every browser). Leave them out and the app is the CyberUnicorn remote only: the
# Frequency tab then says the build is not connected.

# The site that answers /api/v1 (docs/APP-CONTRACT.md). No trailing slash.
EXPO_PUBLIC_API_URL=https://frequencylocal.com

# The site's Supabase project, for sign-in and the session only. Every data read goes through /api/v1.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Expo push (APP-CONTRACT §10) also needs the EAS project id at build time: EAS_PROJECT_ID=…
