{
  "role": "Membership",
  "type": "RoleMembership",
  "label": "Membership (all themes)",
  "replaces": [
    "Tiers",
    "MidnightMembership",
    "NetworkKitMembership",
    "NetworkTiers",
    "TempleTiers"
  ],
  "slots": {
    "required": {
      "items": {
        "type": "list",
        "min": 1,
        "max": 4,
        "item": {
          "name": "text<=40",
          "price": "text<=20",
          "per": "text?",
          "blurb": "text<=160",
          "features": "lines<=8",
          "badge": "text?",
          "featured": "flag",
          "label": "text",
          "href": "link"
        }
      }
    },
    "optional": {
      "eyebrow": "text<=40",
      "heading": "text<=120",
      "lead": "text<=280"
    }
  },
  "variants": {
    "tiers": {
      "label": "Tier cards",
      "max": 4
    },
    "table": {
      "label": "Table rows",
      "max": 4
    },
    "spotlight": {
      "label": "One tier in the spotlight",
      "needs": [
        "featured"
      ]
    }
  },
  "default": "tiers",
  "data": null,
  "sample": {
