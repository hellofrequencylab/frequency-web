{
  "role": "Proof",
  "type": "RoleProof",
  "label": "Proof (all themes)",
  "intent": "Show what members say",
  "why": "Words from the people who already come.",
  "group": "Trust",
  "icon": "message",
  "live": true,
  "replaces": [
    "Quote",
    "CardGrid(testimonial)",
    "MidnightProof",
    "NetworkKitProof",
    "DesignerTestimonials",
    "DesignerQuote"
  ],
  "slots": {
    "required": {
      "items": {
        "type": "list",
        "min": 1,
        "max": 12,
        "item": {
          "quote": "text<=280",
          "name": "text",
          "role": "text?",
          "photo": "image?",
          "rating": "1-5?"
        }
      }
    },
    "optional": {
      "eyebrow": "text<=40",
      "heading": "text<=120",
      "lead": "text<=280",
      "stats": {
        "type": "list",
        "max": 4,
        "item": {
          "value": "text<=12",
          "label": "text<=40"
        }
      }
    },
    "labels": {
      "items": {
        "label": "Quotes",
        "hint": "Words from members, with their names. Filled from your reviews when you have them."
      },
      "eyebrow": {
        "label": "Small line above",
        "hint": "A few words that set the scene. You can leave it out."
      },
      "heading": {
        "label": "Heading",
        "hint": "What this section is about, in your own words."
      },
      "lead": {
        "label": "Intro",
        "hint": "A sentence or two under the heading."
      },
      "stats": {
        "label": "Figures",
        "hint": "Up to four numbers beside the quotes."
      }
    }
  },
  "variants": {
    "quote": {
      "label": "Large quotes",
      "max": 3,
      "thumb": "quote"
    },
    "wall": {
      "label": "Wall of quotes",
      "min": 3,
      "max": 12,
      "thumb": "wall"
    },
    "stats": {
      "label": "Quote beside figures",
      "needs": [
        "stats"
      ],
      "thumb": "figures"
    }
  },
  "default": "wall",
  "data": null,
  "sample": {
    "sample": true,
    "eyebrow": "Kind words",
    "title": "People *keep coming back*",
    "lead": "",
    "items": [
      {
        "quote": "I came alone and left with three friends. It felt like coming home.",
        "name": "Maya R.",
        "role": "Member since 2024",
        "photo": "",
        "rating": 5
      },
      {
        "quote": "Unhurried, warm, and the tea is very good.",
        "name": "Jo T.",
        "role": "Weekly regular",
        "photo": "",
        "rating": 5
      },
      {
        "quote": "The first place in years where I did not feel like I had to perform.",
        "name": "Sam L.",
        "role": "Circle host",
        "photo": "",
        "rating": 5
      }
    ],
    "stats": [
      {
        "value": "240",
        "label": "Gatherings hosted"
      },
      {
        "value": "1,100",
        "label": "People welcomed"
      },
      {
        "value": "4.9",
        "label": "Average rating"
      }
    ]
  },
  "tokens": [
