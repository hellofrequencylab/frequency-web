{
  "role": "Story",
  "type": "RoleStory",
  "label": "Our story (all themes)",
  "intent": "Tell your story",
  "why": "Why you started, in your own words.",
  "group": "Welcome",
  "icon": "page",
  "live": false,
  "replaces": [
    "NetworkKitInnerStory",
    "TempleKitInnerStory",
    "StoryBeats"
  ],
  "slots": {
    "required": {
      "items": {
        "type": "list",
        "min": 1,
        "max": 5,
        "item": {
          "text": "text<=320"
        }
      }
    },
    "optional": {
      "eyebrow": "text<=40",
      "heading": "text<=120",
      "lead": "text<=280",
      "quote": "text<=160",
      "image": "image",
      "alt": "text<=120"
    },
    "labels": {
      "items": {
        "label": "Paragraphs",
        "hint": "Your story, a paragraph at a time."
      },
      "eyebrow": {
        "label": "Small line above",
        "hint": "A few words that set the scene. You can leave it out."
      },
      "heading": {
        "label": "Heading",
        "hint": "What this section is about, in your own words."
      },
      "lead": {
        "label": "Intro",
        "hint": "A sentence or two under the heading."
      },
      "quote": {
        "label": "Pull quote",
        "hint": "One line from your story worth reading twice."
      },
      "image": {
        "label": "Photo",
        "hint": "A real photo of your people or your place."
      },
      "alt": {
        "label": "Photo description",
        "hint": "Say what is in the photo for people who cannot see it."
      }
    }
  },
  "variants": {
    "split": {
      "label": "Words beside a photo",
      "thumb": "split"
    },
    "center": {
      "label": "Centered",
      "thumb": "center"
    }
  },
  "default": "split",
  "sample": {
    "sample": true,
    "eyebrow": "Our story",
    "title": "How this *started*",
    "lead": "",
    "quote": "Replace with the line you would paint on the wall.",
    "items": [
      {
        "text": "The beginning: what you noticed and the first people who came."
      },
      {
        "text": "The middle: what happens here on an ordinary week."
      },
      {
        "text": "Now: who it is for and how someone new gets started."
      }
    ]
  },
  "tokens": [
    "c-accent",
    "c-accent-bg",
    "c-accent-hover",
    "c-accent-text",
    "c-band",
    "c-canvas",
    "c-focus",
    "c-line",
