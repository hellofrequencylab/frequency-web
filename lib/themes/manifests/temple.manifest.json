      "--f-display": "var(--font-display)",
      "--f-body": "var(--font-body)",
      "--f-label": "var(--font-label)",
      "--f-voice": "var(--tp-quote)",
      "--w-display": "400",
      "--track-display": "normal",
      "--case-heading": "none",
      "--lead-display": "1.1",
      "--sp-section": "var(--space-section)",
      "--sp-gap": "16px",
      "--sp-gutter": "clamp(16px,4vw,32px)",
      "--measure": "68ch",
      "--dur-fast": "var(--motion-fast)",
      "--dur": "var(--motion-base)",
      "--ease": "var(--ease-out)"
