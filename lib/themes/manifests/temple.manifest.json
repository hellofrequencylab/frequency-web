  "offered": false,
  "site": {
    "label": "Temple",
    "description": "A lime-washed house: plaster and umber, one clay color, arched photos and cards, warm and unhurried.",
    "defaultFonts": "classic"
  },
  "library": null,
  "editor": {
    "tokens": {
      "--th-bg": "#F8F0E2",
      "--th-surface": "#FFFCF4",
      "--th-raised": "#FDFAF3",
      "--th-hairline": "#E4D8C6",
      "--th-muted": "#7C624D",
      "--th-secondary": "#6B5040",
      "--th-text": "#35251A",
      "--th-accent": "#B75C3C",
      "--th-accent-text": "#9C4A2C",
      "--th-on-accent": "#FFFFFF",
      "--th-season": "#D29A3B",
      "--th-on-season": "#231710",
      "--th-display": "Branch,Marcellus,Georgia,serif",
      "--th-dw": "400",
      "--th-body": "Jost,'Helvetica Neue',sans-serif",
      "--th-mono": "Marcellus,Georgia,serif",
      "--th-r": "16px",
      "--ed-lift": "60%",
      "--ed-lift2": "82%",
      "--th-clip-sm": "inset(0 round 50% 50% 6px 6px / 42% 42% 6px 6px)",
