      "--c-accent-bg": "var(--color-primary-bg)",
      "--c-accent-deep": "var(--color-primary-strong)",
      "--c-accent-text": "var(--color-primary-strong)",
      "--c-line": "var(--color-border)",
      "--c-line-strong": "var(--color-border-strong)",
      "--c-success": "var(--color-success)",
      "--c-warning": "var(--color-warning)",
      "--c-danger": "var(--color-danger)",
      "--c-info": "var(--color-info)",
      "--c-focus": "var(--color-focus-ring)",
      "--c-band": "var(--color-ink)",
      "--c-on-band": "var(--color-on-ink)",
      "--r-control": "var(--radius-control)",
      "--r-card": "var(--radius-card)",
