{
  "schema": 1,
  "id": "network",
  "legacyIds": {
    "editor": "Network",
    "site": "network"
  },
  "offered": false,
  "site": {
    "label": "Network",
    "description": "Coastal and warm: butter-cream grounds, one bold color, pill buttons and real photos up front.",
    "defaultFonts": "modern"
  },
  "library": null,
  "editor": {
    "tokens": {
      "--th-bg": "#FCF9EE",
      "--th-surface": "#FFFEF8",
      "--th-raised": "#F3EFDA",
      "--th-hairline": "#E7E1C8",
      "--th-muted": "#666D72",
      "--th-secondary": "#565E64",
      "--th-text": "#22303A",
      "--th-accent": "#E9B949",
      "--th-accent-text": "#8A6410",
      "--th-on-accent": "#1F3440",
      "--th-season": "#22303A",
      "--th-on-season": "#FFFEF8",
      "--th-display": "'Bricolage Grotesque','Outfit',system-ui,sans-serif",
      "--th-dw": "700",
      "--th-body": "Outfit,system-ui,sans-serif",
      "--th-mono": "Outfit,system-ui,sans-serif",
      "--th-r": "28px",
      "--ed-lift": "62%",
      "--ed-lift2": "85%",
      "--th-clip-sm": "inset(0 round 14px)",
      "--th-clip-md": "inset(0 round 28px)",
      "--th-clip-lg": "inset(0 round 36px)"
    },
    "niches": null,
    "derived": {
      "--ed-chrome": "color-mix(in oklch, var(--th-bg), white var(--ed-lift))",
      "--ed-field": "color-mix(in oklch, var(--th-bg), white var(--ed-lift2))",
      "--ed-line": "color-mix(in oklch, var(--th-hairline), white var(--ed-lift))"
    }
  },
  "core": {
    "names": {
      "--c-canvas": "var(--color-canvas)",
      "--c-surface": "var(--color-surface)",
      "--c-raised": "var(--color-surface-elevated)",
      "--c-sunken": "color-mix(in srgb,var(--color-canvas) 92%,var(--color-text))",
      "--c-text": "var(--color-text)",
      "--c-text-muted": "var(--color-text-muted)",
      "--c-text-subtle": "var(--color-text-subtle)",
      "--c-on-accent": "var(--color-text-on-primary)",
      "--c-accent": "var(--color-primary)",
      "--c-accent-hover": "var(--color-primary-hover)",
      "--c-accent-soft": "color-mix(in srgb,var(--color-primary) 18%,var(--color-canvas))",
      "--c-accent-bg": "var(--color-primary-bg)",
      "--c-accent-deep": "var(--color-primary-strong)",
      "--c-accent-text": "var(--color-primary-strong)",
      "--c-line": "var(--color-border)",
      "--c-line-strong": "var(--color-border-strong)",
      "--c-success": "var(--color-success)",
      "--c-warning": "var(--color-warning)",
      "--c-danger": "var(--color-danger)",
      "--c-info": "var(--color-info)",
      "--c-focus": "var(--color-focus-ring)",
      "--c-band": "var(--color-ink)",
      "--c-on-band": "var(--color-on-ink)",
      "--r-control": "var(--radius-control)",
      "--r-card": "var(--radius-card)",
      "--r-panel": "var(--radius-cover)",
      "--r-media": "var(--radius-cover)",
      "--frame": "inset(0 round 28px)",
      "--shadow-card": "0 1px 2px color-mix(in srgb,var(--color-text) 8%,transparent)",
      "--shadow-lift": "0 12px 28px -12px color-mix(in srgb,var(--color-text) 28%,transparent)",
      "--f-display": "var(--font-display)",
      "--f-body": "var(--font-body)",
      "--f-label": "var(--font-label)",
      "--f-voice": "var(--nw-voice)",
      "--w-display": "700",
      "--track-display": "normal",
      "--case-heading": "none",
      "--lead-display": "1.1",
      "--sp-section": "var(--space-section)",
      "--sp-gap": "16px",
      "--sp-gutter": "clamp(16px,4vw,32px)",
      "--measure": "68ch",
      "--dur-fast": "var(--motion-fast)",
      "--dur": "var(--motion-base)",
      "--ease": "var(--ease-out)"
    }
  }
}
